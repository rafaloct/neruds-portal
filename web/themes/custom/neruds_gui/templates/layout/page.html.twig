{#
/**
 * @file page.html.twig
 * NERUDS-GUI — Layout Principal Responsivo
 */
#}

<div id="page-wrapper" class="page-wrapper">
  <div id="page" class="page">

    {# ── HEADER ────────────────────────────────────────────────────── #}
    <header id="header" class="site-header" role="banner">
      <div class="site-header__inner layout-container">

        {# Branding #}
        <div class="site-header__brand">
          {% if page.header %}{{ page.header }}{% endif %}
        </div>

        {# Hamburger — mobile only #}
        <button
          class="nav-toggle"
          aria-controls="primary-nav"
          aria-expanded="false"
          aria-label="{{ 'Abrir menu de navegação'|t }}"
        >
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
        </button>

        {# Primary nav #}
        <nav id="primary-nav" class="primary-nav" role="navigation"
             aria-label="{{ 'Menu principal'|t }}" data-state="closed">
          {% if page.primary_menu %}{{ page.primary_menu }}{% endif %}
        </nav>

        <a class="site-header__search-link" href="/busca" aria-label="{{ 'Abrir busca do site'|t }}">
          <svg class="site-header__search-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>{{ 'Busca'|t }}</span>
        </a>

        {# Secondary actions: account, language #}
        <div class="site-header__actions">
          {% if page.secondary_menu %}{{ page.secondary_menu }}{% endif %}
        </div>

      </div>
    </header>

    {# ── HERO ──────────────────────────────────────────────────────── #}
    {% if page.hero and is_front %}
      <section class="region-hero" role="region" aria-label="{{ 'Seção de destaque'|t }}">
        <div class="layout-container">{{ page.hero }}</div>
      </section>
    {% endif %}

    {# ── BREADCRUMB ────────────────────────────────────────────────── #}
    {% if page.breadcrumb %}
      <nav class="breadcrumb-bar" aria-label="{{ 'Localização'|t }}">
        <div class="layout-container">{{ page.breadcrumb }}</div>
      </nav>
    {% endif %}

    {# ── HIGHLIGHTED MESSAGES ──────────────────────────────────────── #}
    {% if page.highlighted %}
      <div class="region-highlighted" role="alert">
        <div class="layout-container">{{ page.highlighted }}</div>
      </div>
    {% endif %}

    {# ── MAIN ──────────────────────────────────────────────────────── #}
    <main id="main-content" class="site-main" role="main" tabindex="-1">
      <div class="layout-container">

        {% if page.content_above %}
          <section class="region-content-above">{{ page.content_above }}</section>
        {% endif %}

        <div class="content-layout{% if page.sidebar %} content-layout--sidebar{% endif %}">

          <article class="content-layout__main">
            {% if is_neruds_contact %}
              <div class="neruds-contact-layout">
                <aside class="neruds-contact-intro" aria-labelledby="contact-intro-title">
                  <h2 id="contact-intro-title">{{ 'Fale com o NERUDS'|t }}</h2>
                  <p>{{ 'Núcleo de Estudos Rurais, Desigualdades e Sistemas Socioecológicos'|t }}</p>
                  <p>{{ 'Use o formulário para informações sobre pesquisas, propostas de parceria, eventos ou contato com a imprensa.'|t }}</p>
                  <p><a href="{{ path('entity.node.canonical', {'node': 318}) }}">{{ 'Conheça o núcleo'|t }}</a></p>
                </aside>
                <div class="neruds-contact-panel">{{ page.content }}</div>
              </div>
            {% else %}{{ page.content }}{% endif %}
          </article>

          {% if page.sidebar %}
            <aside class="content-layout__sidebar" role="complementary"
                   aria-label="{{ 'Barra lateral'|t }}">
              {{ page.sidebar }}
            </aside>
          {% endif %}

        </div>

        {% if page.content_below %}
          <section class="region-content-below">{{ page.content_below }}</section>
        {% endif %}

      </div>
    </main>

    {# ── SOCIAL BAR ────────────────────────────────────────────────── #}
    {% if page.social_bar %}
      <section class="region-social-bar" aria-label="{{ 'Compartilhar'|t }}">
        <div class="layout-container">{{ page.social_bar }}</div>
      </section>
    {% endif %}

  </div>{# /page #}

  {# ── FOOTER ────────────────────────────────────────────────────────── #}
  <footer class="site-footer" role="contentinfo">
    <div class="layout-container">

      {% if page.footer_top %}
        <div class="site-footer__top">{{ page.footer_top }}</div>
      {% endif %}

      <div class="site-footer__bottom">
        {% if page.footer_bottom %}
          {{ page.footer_bottom }}
        {% endif %}
        <p class="site-footer__copy">
          &copy; {{ "now"|date("Y") }}
          <strong>{{ site_name }}</strong> —
          {{ 'Núcleo de Estudos Rurais, Desigualdades e Sistemas Socioecológicos'|t }}
        </p>
      </div>

    </div>
  </footer>

</div>{# /page-wrapper #}
