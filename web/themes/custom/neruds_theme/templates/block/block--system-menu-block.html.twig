{#
/**
 * @file
 * Template para blocos de menu do sistema
 * Seguindo as melhores práticas do Drupal 11
 * @see https://www.drupal.org/docs/develop/theming-drupal
 *
 * Variáveis disponíveis:
 * - content: Conteúdo renderizado do bloco
 * - attributes: Atributos HTML do wrapper
 * - title_attributes: Atributos do título
 * - label: Título do bloco
 * - title_prefix: Prefixo do título (contextual links)
 * - title_suffix: Sufixo do título
 */
#}

{%
  set classes = [
    'block',
    'block-menu',
    'navigation',
    'menu--' ~ derivative_plugin_id|clean_class,
  ]
%}

{% set heading_id = attributes.id ~ '-menu'|clean_id %}
<nav role="navigation" aria-labelledby="{{ heading_id }}"{{ attributes.addClass(classes)|without('role', 'aria-labelledby') }}>
  {% block content %}
    {% if label %}
      <h2{{ title_attributes.setAttribute('id', heading_id) }}>{{ label }}</h2>
    {% endif %}
    {{ content }}
  {% endblock %}
</nav>

