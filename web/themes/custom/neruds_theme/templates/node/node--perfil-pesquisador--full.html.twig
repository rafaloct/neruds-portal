{#
/**
 * @file
 * Template para exibição completa do perfil de pesquisador
 * Seguindo as melhores práticas do Drupal 11
 * @see https://www.drupal.org/docs/develop/theming-drupal
 *
 * Variáveis disponíveis:
 * - node: Entidade do nó
 * - content: Conteúdo renderizado do nó
 * - attributes: Atributos HTML do wrapper
 * - label: Título do nó
 * - view_mode: Modo de visualização
 * - title_prefix: Prefixo do título
 * - title_suffix: Sufixo do título
 * - has_photo: Boolean indicando se tem foto (via preprocess)
 * - projects_count: Número de projetos (via preprocess)
 * - productions_count: Número de produções (via preprocess)
 */
#}
{{ attach_library('neruds_theme/neruds-ant-design') }}
{{ attach_library('neruds_theme/neruds-forms-tables') }}
{{ attach_library('neruds_theme/neruds-perfil-pesquisador') }}

<div class="node-perfil-pesquisador node-perfil-pesquisador--full neruds-ant-design">
  <article{{ attributes.addClass('pesquisador-perfil-card') }}>
    
    {# Header com Foto e Nome #}
    <header class="pesquisador-header-section">
      <div class="pesquisador-header-content">
        
        {# Foto do Perfil #}
        {% set foto_field = node.field_foto_perfil %}
        {% if foto_field and not foto_field.isEmpty() and foto_field.entity %}
          <div class="pesquisador-foto-wrapper">
            {{ content.field_foto_perfil }}
          </div>
        {% else %}
          <div class="pesquisador-foto-wrapper pesquisador-foto-placeholder">
            <div class="pesquisador-foto-icon">
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" fill="currentColor"/>
              </svg>
            </div>
          </div>
        {% endif %}

        {# Nome e Título #}
        <div class="pesquisador-info-header">
          {% if content.field_nome_completo|render|striptags|trim %}
            <h1 class="pesquisador-nome">{{ content.field_nome_completo }}</h1>
          {% else %}
            <h1 class="pesquisador-nome">{{ label }}</h1>
          {% endif %}
          
          {# Links Externos #}
          <div class="pesquisador-links-externos">
            {% if content.field_lattes|render|striptags|trim %}
              <a href="{{ content.field_lattes['#items'].0.uri }}" target="_blank" rel="noopener" class="link-neruds link-lattes">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/>
                </svg>
                Lattes
              </a>
            {% endif %}
            
            {% if content.field_orcid|render|striptags|trim %}
              <a href="https://orcid.org/{{ content.field_orcid }}" target="_blank" rel="noopener" class="link-neruds link-orcid">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z" fill="currentColor"/>
                </svg>
                ORCID
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </header>

    {# Conteúdo Principal #}
    <div class="pesquisador-content-section">
      
      {# Biografia #}
      {% if content.field_biografia|render|striptags|trim %}
        <section class="pesquisador-secao pesquisador-biografia-section">
          <h2 class="pesquisador-secao-titulo">Resumo Biográfico</h2>
          <div class="pesquisador-biografia">
            {{ content.field_biografia }}
          </div>
        </section>
      {% endif %}

      {# Informações em Grid #}
      <div class="pesquisador-info-grid">
        
        {# Linhas de Pesquisa #}
        {% if content.field_linhas_pesquisa|render|striptags|trim %}
          <section class="pesquisador-secao pesquisador-linhas-section">
            <h3 class="pesquisador-secao-titulo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Linhas de Pesquisa
            </h3>
            <div class="pesquisador-taxonomia-tags">
              {{ content.field_linhas_pesquisa }}
            </div>
          </section>
        {% endif %}

        {# ODS de Interesse #}
        {% if content.field_ods_interesse|render|striptags|trim %}
          <section class="pesquisador-secao pesquisador-ods-section">
            <h3 class="pesquisador-secao-titulo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              ODS de Interesse
            </h3>
            <div class="pesquisador-taxonomia-tags pesquisador-ods-tags">
              {{ content.field_ods_interesse }}
            </div>
          </section>
        {% endif %}

        {# Áreas de Conhecimento #}
        {% if content.field_areas_conhecimento|render|striptags|trim %}
          <section class="pesquisador-secao pesquisador-areas-section">
            <h3 class="pesquisador-secao-titulo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Áreas de Conhecimento
            </h3>
            <div class="pesquisador-taxonomia-tags">
              {{ content.field_areas_conhecimento }}
            </div>
          </section>
        {% endif %}

        {# Eixos Temáticos #}
        {% if content.field_eixos_tematicos|render|striptags|trim %}
          <section class="pesquisador-secao pesquisador-eixos-section">
            <h3 class="pesquisador-secao-titulo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Eixos Temáticos
            </h3>
            <div class="pesquisador-taxonomia-tags">
              {{ content.field_eixos_tematicos }}
            </div>
          </section>
        {% endif %}
      </div>

      {# Projetos e Produções #}
      <div class="pesquisador-relacionados-grid">
        
        {# Projetos #}
        {% if content.field_projetos_pesquisador|render|striptags|trim %}
          <section class="pesquisador-secao pesquisador-projetos-section">
            <h3 class="pesquisador-secao-titulo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Projetos
            </h3>
            <div class="pesquisador-projetos-lista">
              {{ content.field_projetos_pesquisador }}
            </div>
          </section>
        {% endif %}

        {# Produções #}
        {% if content.field_producoes_pesquisador|render|striptags|trim %}
          <section class="pesquisador-secao pesquisador-producoes-section">
            <h3 class="pesquisador-secao-titulo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="10 9 9 9 8 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Produções
            </h3>
            <div class="pesquisador-producoes-lista">
              {{ content.field_producoes_pesquisador }}
            </div>
          </section>
        {% endif %}
      </div>

      {# Contato #}
      {% if content.field_email|render|striptags|trim or content.field_telefone|render|striptags|trim %}
        <section class="pesquisador-secao pesquisador-contato-section">
          <h3 class="pesquisador-secao-titulo">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Contato
          </h3>
          <div class="pesquisador-contato-info">
            {% if content.field_email|render|striptags|trim %}
              <div class="pesquisador-contato-item">
                <strong>Email:</strong> 
                <a href="mailto:{{ content.field_email['#items'].0.value }}">{{ content.field_email }}</a>
              </div>
            {% endif %}
            {% if content.field_telefone|render|striptags|trim %}
              <div class="pesquisador-contato-item">
                <strong>Telefone:</strong> {{ content.field_telefone }}
              </div>
            {% endif %}
          </div>
        </section>
      {% endif %}

    </div>

    {{ content|without(
      'field_foto_perfil',
      'field_nome_completo',
      'field_biografia',
      'field_linhas_pesquisa',
      'field_ods_interesse',
      'field_areas_conhecimento',
      'field_eixos_tematicos',
      'field_projetos_pesquisador',
      'field_producoes_pesquisador',
      'field_lattes',
      'field_orcid',
      'field_email',
      'field_telefone'
    ) }}
    
  </article>
</div>
